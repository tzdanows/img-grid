{
  "lock": false,
  "imports": {
    "@std/http": "jsr:@std/http@^1.0.17"
  },
  "tasks": {
    "dev": "deno run --allow-net --allow-read --allow-env --watch=static/,lib/,content.json cloudinary-server.ts",
    "start": "deno run --allow-net --allow-read --allow-env cloudinary-server.ts",
    "build": "echo 'No build step needed for Cloudinary server'",
    "check": "deno check **/*.ts",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "test": "deno test --allow-read --allow-env",
    "ci": "deno fmt --check && deno lint && deno test --allow-read --allow-env --quiet",
    "setup": "deno run -A scripts/setup.ts",
    "edit": "deno run -A scripts/edit-content.ts",
    "add-links": "deno run -A scripts/add-links.ts"
  },
  "test": {
    "include": ["tests/"],
    "exclude": ["static/", "node_modules/"]
  }
}
